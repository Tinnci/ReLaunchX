<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 完整迁移旧项目 Manifest 中的所有权限 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.RESTART_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REBOOT" />
    <uses-permission android:name="android.permission.DEVICE_POWER" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ReLaunchXModern"
        android:name=".ReLaunchApp"
        tools:targetApi="31">

        <!-- 新项目原有的 MainActivity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ReLaunchXModern">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 迁移旧项目中的所有 Activity 声明 -->
        <activity android:name=".Home"
                  android:launchMode="singleInstance"
                  android:stateNotNeeded="true"
                  android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME"/>
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity android:name=".Home1"
                  android:launchMode="singleInstance"
                  android:stateNotNeeded="true"
                  android:exported="true">
            <intent-filter>
                <action android:name="com.bn.intent.action.home" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="quicknav.view" android:value="true" />
        </activity>

        <activity android:name=".Shop"
                  android:launchMode="singleInstance"
                  android:stateNotNeeded="true"
                  android:exported="true">
            <intent-filter>
                <action android:name="com.bn.intent.action.shop" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="quicknav.view" android:value="true" />
        </activity>

        <activity android:name=".Library"
                  android:launchMode="singleInstance"
                  android:stateNotNeeded="true"
                  android:exported="true">
            <intent-filter>
                <action android:name="com.bn.intent.action.library"></action>
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="quicknav.view" android:value="true" />
        </activity>

        <activity android:name=".Main"
                  android:launchMode="singleInstance"
                  android:stateNotNeeded="true"
                  android:label="@string/app_name"
                  android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
       </activity>

        <!-- 迁移旧项目中的 LockScreen Service -->
        <service android:name=".LockScreen" android:exported="true"/>

        <activity android:name="ReLaunch"
                  android:exported="true">
            <intent-filter>
                <category android:name="android.intent.category.LAUNCHER"></category>
            </intent-filter>
        </activity>
       <activity android:name="Advanced"
                 android:exported="true">
            <intent-filter>
                <category android:name="android.intent.category.LAUNCHER"></category>
            </intent-filter>
        </activity>
       <activity android:name="AllApplications"
                 android:exported="true">
            <intent-filter>
                <category android:name="android.intent.category.LAUNCHER"></category>
            </intent-filter>
        </activity>
        <activity android:name="TypesActivity"
                  android:exported="true">
            <intent-filter>
                <category android:name="android.intent.category.LAUNCHER"></category>
            </intent-filter>
        </activity>
        <activity android:name="PrefsActivity" android:theme="@android:style/Theme.Light"
                  android:exported="true">
            <intent-filter>
                <category android:name="android.intent.category.LAUNCHER"></category>
            </intent-filter>
        </activity>
        <activity android:name="SearchActivity"
                  android:exported="true">
            <intent-filter>
                <category android:name="android.intent.category.LAUNCHER"></category>
            </intent-filter>
        </activity>
        <activity android:name="ResultsActivity"
                  android:exported="true">
            <intent-filter>
                <category android:name="android.intent.category.LAUNCHER"></category>
            </intent-filter>
        </activity>
        <activity android:name="FiltersActivity"
                  android:exported="true">
            <intent-filter>
                <category android:name="android.intent.category.LAUNCHER"></category>
            </intent-filter>
        </activity>
        <activity android:name="TaskManager"
                  android:exported="true">
            <intent-filter>
                <category android:name="android.intent.category.LAUNCHER"></category>
            </intent-filter>
        </activity>
        <activity android:name="Viewer"
                  android:exported="true">
            <intent-filter>
                <category android:name="android.intent.category.LAUNCHER"></category>
            </intent-filter>
        </activity>
        <activity android:name="Editor"
                  android:exported="true">
            <intent-filter>
                <category android:name="android.intent.category.LAUNCHER"></category>
            </intent-filter>
        </activity>

    </application>

</manifest>